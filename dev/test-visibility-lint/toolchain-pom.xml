<!--
  Standalone (non-reactor) helper pom used only to materialize a fixed
  scalac + semanticdb-scalac + scalafix-cli toolchain classpath for
  dev/lint-scala-test-visibility. This is intentionally NOT part of the
  Spark reactor build (it is never referenced from the root pom's
  <modules>) so that it cannot affect `mvn install`/`mvn package` of Spark
  itself; it is only ever invoked directly via
  `mvn -f dev/test-visibility-lint/toolchain-pom.xml ...`.

  The three direct dependencies below pull in the full transitive closure
  needed to run scalac with the semanticdb-scalac compiler plugin enabled,
  and to run scalafix-cli with a semantic rule against the resulting
  .semanticdb files. Versions are pinned to match Spark's own Scala
  version (2.13.18); bump them together if Spark's Scala version changes.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.spark.dev</groupId>
  <artifactId>test-visibility-lint-toolchain</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <scala.version>2.13.18</scala.version>
    <scalafix.version>0.14.10</scalafix.version>
    <semanticdb.version>4.17.4</semanticdb.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo1.maven.org/maven2</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala-compiler</artifactId>
      <version>${scala.version}</version>
    </dependency>
    <dependency>
      <groupId>org.scalameta</groupId>
      <artifactId>semanticdb-scalac_${scala.version}</artifactId>
      <version>${semanticdb.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.epfl.scala</groupId>
      <artifactId>scalafix-cli_${scala.version}</artifactId>
      <version>${scalafix.version}</version>
    </dependency>
  </dependencies>
</project>
